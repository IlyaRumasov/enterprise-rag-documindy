    {
      "id": "993e41b2-f8ae-4ede-a7de-90ac549d6cad",
      "name": "Chunk Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const file = $('Loop Over Files').first().json;\nconst pages = $input.first().json.text;\nconst pageArr = Array.isArray(pages) ? pages : [String(pages || '')];\nconst footer = /(Сторінка|Страница|Page)\\s*\\d+\\s*(з|из|of)\\s*\\d+/gi;\nconst junkHead = /(Історія змін|История изменений|Зміст|Содержание)/i;\nconst SIZE = 1000, OVERLAP = 200, BATCH = 90;\nconst chunks = [];\npageArr.forEach((raw, i) => {\n  const t = String(raw || '').replace(footer, ' ').replace(/[ \\t]+/g, ' ').replace(/\\n{3,}/g, '\\n\\n').trim();\n  if (t.length < 120) return;\n  if (junkHead.test(t.slice(0, 200)) && t.length < 1200) return;\n  let start = 0;\n  while (start < t.length) {\n    let end = Math.min(start + SIZE, t.length);\n    if (end < t.length) {\n      const cut = Math.max(t.lastIndexOf('\\n', end), t.lastIndexOf('. ', end));\n      if (cut > start + SIZE * 0.5) end = cut + 1;\n    }\n    const piece = t.slice(start, end).trim();\n    if (piece.length >= 100) chunks.push({ text: piece, page: i + 1 });\n    if (end >= t.length) break;\n    start = Math.max(end - OVERLAP, start + 1);\n  }\n});\nif (!chunks.length) return [{ json: { chunks: [], requests: [], hasChunks: false, fileName: file.name } }];\nconst out = [];\nfor (let b = 0; b < chunks.length; b += BATCH) {\n  const part = chunks.slice(b, b + BATCH);\n  out.push({ json: {\n    hasChunks: true,\n    fileName: file.name,\n    chunks: part,\n    requests: part.map(c => ({ model: 'models/gemini-embedding-001', content: { parts: [{ text: c.text }] }, taskType: 'RETRIEVAL_DOCUMENT', title: file.name }))\n  } });\n}\nreturn out;"
      }
    },
    {
