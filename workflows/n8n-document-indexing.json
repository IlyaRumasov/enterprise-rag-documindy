    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\n// білий список файлів бази знань: ID Drive (includeFileIds), назва файлу з довідника docMeta { назва: [категорія, підкатегорія, 'v'] }\n// і папка-приймач inboxFolders { ID підпапки: категорія }: усе, що лежить у ній, додається автоматично\nconst ids = cfg.includeFileIds ? new Set(JSON.parse(cfg.includeFileIds)) : null;\nconst meta = cfg.docMeta ? JSON.parse(cfg.docMeta) : {};\nconst inbox = cfg.inboxFolders ? JSON.parse(cfg.inboxFolders) : {};\nconst hasMeta = Object.keys(meta).length > 0;\nconst re = cfg.fileNameRegex ? new RegExp(cfg.fileNameRegex, 'i') : null;\nconst inboxCat = f => (f.parents || []).map(p => inbox[p]).find(Boolean);\nreturn $input.all()\n  .filter(i => inboxCat(i.json) || (!ids && !re && !hasMeta) || (ids && ids.has(i.json.id)) || meta[i.json.name] || (re && re.test(i.json.name)))\n  .map(i => { const f = i.json; const ic = inboxCat(f); const m = meta[f.name] || [];\n    return { json: { id: f.id, name: f.name, modifiedTime: f.modifiedTime, category: ic || m[0] || 'other', sub: ic ? '' : (m[1] || ''),\n      vision: ic ? Number(f.size || 0) <= 14e6 : m[2] === 'v', inbox: !!ic, parent: (f.parents || [])[0] || '' } }; });"
      },
