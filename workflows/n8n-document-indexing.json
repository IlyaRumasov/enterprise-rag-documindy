        "jsCode": "const f = $('Loop Over Files').first().json;\nconst item = $input.first();\nif (f.vision) {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  item.json.pdfB64 = buf.toString('base64');\n}\nreturn [item];"
      },
