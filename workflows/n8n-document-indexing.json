      "id": "b1b2c3d4-0003-4000-8000-000000000103",
      "name": "Read Pages With Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2896,
        620
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "<CREDENTIAL_ID>",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Extract PDF Text').first().json.text;\nconst pages = Array.isArray(base) ? base : [String(base || '')];\nlet v = [];\ntry { v = JSON.parse($input.first().json.candidates[0].content.parts[0].text); } catch (e) { v = []; }\nconst byPage = {};\nv.forEach(x => { byPage[x.page] = String(x.text || ''); });\nconst n = Math.max(pages.length, ...v.map(x => x.page || 0));\nconst merged = [];\nfor (let i = 0; i < n; i++) {\n  const native = String(pages[i] || '').trim();\n  merged.push(native.length >= 400 || !byPage[i + 1] ? native : byPage[i + 1]);\n}\nreturn [{ json: { text: merged } }];"
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000104",
      "name": "Merge Vision Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// Для файлів із папки-приймача: не індексуємо документи з паролями, ключами, телефонами чи особистою поштою\nconst file = $('Loop Over Files').first().json;\nconst items = $input.all();\nif (!file.inbox) return items;\nconst text = items.map(i => (i.json.chunks || []).map(c => c.text).join('\\n')).join('\\n');\nconst SECRET = /(парол\\w*|password|пароль|pass|логін|логин|login|token|api[_ -]?key|secret)\\s*[:=]\\s*\\S{6,}/i;\nconst KEY = /(AIza[0-9A-Za-z_-]{20,}|eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-[A-Za-z0-9]{20,})/;\nconst PHONE = /(?:\\+?38)?[\\s(]*0\\d{2}[\\s)\\-]*\\d{3}[\\s\\-]?\\d{2}[\\s\\-]?\\d{2}/;\nconst PERSONAL = /[\\w.+-]+@(gmail|ukr|yahoo|outlook|hotmail|icloud|i)\\.(com|net)\\b/i;\nlet reason = '';\nif (SECRET.test(text)) reason = 'у тексті схоже на пароль або логін зі значенням';\nelse if (KEY.test(text)) reason = 'у тексті схоже на ключ або токен';\nelse if (PHONE.test(text)) reason = 'у тексті є номер телефону';\nelse if (PERSONAL.test(text)) reason = 'у тексті є особиста поштова адреса';\nif (reason) return [{ json: { hasChunks: false, blocked: true, reason, chunks: [], requests: [] } }];\nreturn items;"
      },
