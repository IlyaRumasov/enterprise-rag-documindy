    {
      "id": "7cfcd991-4bad-45d8-b42e-2cb9815c8c9f",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        2560,
        300
      ],
      "parameters": {
        "operation": "pdf",
