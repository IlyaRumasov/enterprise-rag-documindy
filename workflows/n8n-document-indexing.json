    {
      "id": "7a5102f0-68a9-431f-87a5-6620a8b6b9b9",
      "name": "Embed Chunks (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        3220,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:batchEmbedContents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ requests: $json.requests }) }}",
        "options": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "<CREDENTIAL_ID>",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "681ec3f7-d5b4-41a0-9c20-327e35328058",
      "name": "Build Qdrant Points",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const file = $('Loop Over Files').first().json;\nconst batches = $('Chunk Pages').all();\nfunction uuid(s) {\n  let a = 0x9e3779b9, b = 0x85ebca6b, c = 0xc2b2ae35, d = 0x27d4eb2f;\n  for (let i = 0; i < s.length; i++) {\n    const k = s.charCodeAt(i);\n    a = Math.imul(a ^ k, 597399067); b = Math.imul(b ^ k, 2869860233);\n    c = Math.imul(c ^ k, 951274213); d = Math.imul(d ^ k, 2716044179);\n  }\n  a ^= (b ^ c ^ d); b ^= a; c ^= b; d ^= c;\n  const x = [a, b, c, d].map(v => (v >>> 0).toString(16).padStart(8, '0')).join('');\n  return x.slice(0, 8) + '-' + x.slice(8, 12) + '-4' + x.slice(13, 16) + '-8' + x.slice(17, 20) + '-' + x.slice(20, 32);\n}\nconst points = [];\nlet n = 0;\n$input.all().forEach((it, bi) => {\n  const chunks = batches[bi].json.chunks;\n  (it.json.embeddings || []).forEach((e, i) => {\n    points.push({\n      id: uuid(file.id + ':' + n),\n      vector: e.values,\n      payload: {\n        content: chunks[i].text,\n        metadata: { fileId: file.id, fileName: file.name, modifiedTime: file.modifiedTime, chunk: n, loc: { pageNumber: chunks[i].page } }\n      }\n    });\n    n++;\n  });\n});\nreturn [{ json: { points, count: points.length } }];"
      }
    },
