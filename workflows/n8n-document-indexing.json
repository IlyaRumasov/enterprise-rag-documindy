    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-preview:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ inline_data: { mime_type: 'application/pdf', data: $('Encode PDF').item.json.pdfB64 } }, { text: \"Ти обробляєш PDF-інструкцію з розмітки даних або внутрішній документ компанії. Для КОЖНОЇ сторінки поверни елемент {page, text}. У text дай: 1) весь видимий текст сторінки; 2) стислий опис кожного зображення, схеми, скриншота або прикладу розмітки: що саме показано і яке правило чи клас це ілюструє. Пиши мовою документа. Не вигадуй: описуй лише те, що видно на сторінці.\" }] }], generationConfig: { temperature: 0, maxOutputTokens: 60000, responseMimeType: 'application/json', responseSchema: { type: 'ARRAY', items: { type: 'OBJECT', properties: { page: { type: 'INTEGER' }, text: { type: 'STRING' } }, required: ['page', 'text'] } } } }) }}",
        "options": {
          "timeout": 300000
