    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\n// білий список файлів бази знань (ID Drive); якщо порожній, діє фільтр за назвою\nconst ids = cfg.includeFileIds ? new Set(JSON.parse(cfg.includeFileIds)) : null;\nconst re = cfg.fileNameRegex ? new RegExp(cfg.fileNameRegex, 'i') : null;\nreturn $input.all()\n  .filter(i => (!ids && !re) || (ids && ids.has(i.json.id)) || (re && re.test(i.json.name)))\n  .map(i => ({ json: { id: i.json.id, name: i.json.name, modifiedTime: i.json.modifiedTime } }));"
      },
