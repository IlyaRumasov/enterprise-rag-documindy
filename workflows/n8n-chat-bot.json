      "id": "54e1ea98-287d-4aa9-b89e-62911444f10e",
      "name": "Ask DocuMindy (Flowise)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1344,
        96
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "<CREDENTIAL_ID>",
          "name": "Flowise"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const ev = $('Normalize Chat Event').first().json;\nconst r = $input.first().json;\nlet text = String(r.text || '').trim();\nconst notFound = text.startsWith('На жаль, у внутрішніх');\nconst esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet html = esc(text).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>').replace(/^\\s*[*-]\\s+/gm, '• ').replace(/\\n/g, '<br>');\nif (html.length > 3500) html = html.slice(0, 3500) + '…';\nconst pages = {};\n(r.sourceDocuments || []).forEach(d => {\n  const m = d.metadata || {};\n  const f = m.fileName || m.source || m.name;\n  if (!f) return;\n  (pages[f] = pages[f] || new Set()).add(m.loc && m.loc.pageNumber);\n});\nconst src = notFound ? [] : Object.keys(pages).slice(0, 3).map(f => {\n  const p = Array.from(pages[f]).filter(Boolean).sort((a, b) => a - b);\n  return '📌 ' + esc(f.replace(/\\.pdf$/i, '')) + (p.length ? ', стор. ' + p.join(', ') : '');\n});\nconst widgets = [{ textParagraph: { text: html } }];\nif (src.length) widgets.push({ divider: {} }, { textParagraph: { text: '<font color=\"#808080\">' + src.join('<br>') + '</font>' } });\nconst body = { cardsV2: [{ cardId: 'documindyAnswer', card: { header: { title: 'DocuMindy', subtitle: 'Корпоративний асистент' }, sections: [{ widgets }] } }] };\nconst hash = s => { let a = 0xdeadbeef, b = 0x41c6ce57; for (let i = 0; i < s.length; i++) { const c = s.charCodeAt(i); a = Math.imul(a ^ c, 2654435761); b = Math.imul(b ^ c, 1597334677); } a = Math.imul(a ^ (a >>> 16), 2246822507) ^ Math.imul(b ^ (b >>> 13), 3266489909); b = Math.imul(b ^ (b >>> 16), 2246822507) ^ Math.imul(a ^ (a >>> 13), 3266489909); return (4294967296 * (2097151 & b) + (a >>> 0)).toString(36); };\nconst first = (r.sourceDocuments || [])[0] || {};\nconst fm = first.metadata || {};\nconst log = {\n  askedAt: new Date().toISOString(),\n  userHash: hash('documindy|' + String(ev.sessionId).split('|').pop()),\n  question: String(ev.chatInput).slice(0, 500),\n  answered: !notFound,\n  topSource: fm.fileName || '',\n  topPage: (fm.loc && fm.loc.pageNumber) || 0,\n  sourceCount: (r.sourceDocuments || []).length,\n  answerChars: text.length\n};\nreturn [{ json: { space: ev.space, body, log } }];"
      },
