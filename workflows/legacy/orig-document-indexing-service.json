    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  // Отримуємо доступ до бінарних даних файлу\n  const binaryKey = Object.keys(item.binary)[0];\n\n  if (item.binary[binaryKey]) {\n    // Берeмо назву файлу з JSON (яку дав Google Drive)\n    // і записуємо її прямо у властивості файлу, щоб Loader її побачив\n    item.binary[binaryKey].fileName = item.json.name;\n  }\n\n  return item;\n});"
      },
